# Copy to .env — loaded automatically at startup. Never commit .env.
# Alpaca paper trading keys: https://app.alpaca.markets/ -> Paper Trading -> API Keys
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Only for live trading. Both must be set on purpose.
# SENTINEL_CONFIRM_LIVE=yes

# Optional: long-lived Claude Code token for machines without an interactive login (claude setup-token)
# CLAUDE_CODE_OAUTH_TOKEN=
